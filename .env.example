# ==========================================
# Commerce Agent Protocol (CAP) — Environment Variables
# Copy this file to .env and fill in the values
# ==========================================

# --- Database ---
DATABASE_URL="postgresql://cap_user:cap_password@localhost:5432/cap_db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
# Optional fallback if REDIS_URL is unset (BullMQ + ioredis both honor REDIS_URL first):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# For Upstash (production):
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXXxxx..."

# --- OpenAI ---
OPENAI_API_KEY="sk-proj-..."

# --- Shopify App ---
SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"
# Admin scopes: catalog + orders (webhooks reconcile checkouts).
# Unauthenticated_* scopes are propagated to the Storefront access token CAP
# provisions during OAuth, and unlock the Cart API used by /v1/checkout/initiate.
SHOPIFY_SCOPES="read_products,read_inventory,read_locations,read_orders,read_shipping,read_legal_policies,read_markets_home,unauthenticated_read_product_listings,unauthenticated_read_product_inventory,unauthenticated_write_checkouts"
SHOPIFY_APP_URL="https://api.cap-protocol.org"
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_TIMEOUT_MS=10000

# --- Encryption ---
# 32-byte key for AES-256-GCM encryption of Shopify tokens: `openssl rand -hex 32`
# (64 hex chars) or `openssl rand -base64 32`. Example values are rejected at boot,
# and production requires one of these two formats.
ENCRYPTION_KEY="change_me_to_a_32_byte_random_key_!!"
# During a key rotation, put the old key here so stored tokens stay readable.
# ENCRYPTION_KEY_PREVIOUS=""

# --- API ---
API_PORT=3000
NODE_ENV="development"
# Dedicated bearer token for /internal/operations/* (`openssl rand -hex 32`).
CAP_OPERATIONS_TOKEN="change_me_to_a_random_operations_secret"

# --- Data retention (optional, days) ---
# AGENT_QUERY_RETENTION_DAYS=180
# WEBHOOK_EVENT_RETENTION_DAYS=30

# --- Dashboard ---
NEXT_PUBLIC_API_URL="http://localhost:3000"
# `openssl rand -hex 32`; example values are rejected at boot.
DASHBOARD_SESSION_SECRET="change_me_to_a_random_secret_of_at_least_32_chars"
DASHBOARD_URL="http://localhost:3001"

# --- MCP server (stdio mode) ---
# When CAP runs as an MCP server (`pnpm --silent -C apps/api mcp`), tool calls are not authenticated
# by an API key. Bind the server to a single merchant via this environment var.
# CAP_MERCHANT_ID="00000000-0000-0000-0000-000000000000"

# --- Monitoring (optional) ---
# SENTRY_DSN="https://xxx@sentry.io/xxx"
# AXIOM_TOKEN="axm-xxx"
# AXIOM_ORG_ID="your-org"
