{
  "name": "cap-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Commerce Agent Protocol — Middleware connecting e-commerce catalogs to AI shopping agents",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter=@cap/db db:generate",
    "db:migrate": "pnpm --filter=@cap/db db:migrate",
    "db:check-drift": "pnpm --filter=@cap/db db:check-drift",
    "db:studio": "pnpm --filter=@cap/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "dev:workers": "pnpm --filter=@cap/api dev:workers",
    "smoke:staging": "bash scripts/smoke-staging.sh",
    "test:shopify": "pnpm --filter @cap/api exec vitest run src/__tests__/shopify-security.test.ts src/__tests__/shopify-contract.test.ts",
    "e2e:shopify": "bash scripts/shopify-e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.5",
      "body-parser": "2.4.0",
      "express-rate-limit": "8.6.2",
      "fast-uri@3": "3.1.9",
      "form-data": "4.0.6",
      "ip-address": "10.7.5",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.29",
      "postcss-selector-parser@6": "6.1.5",
      "proxy-addr": "2.0.8",
      "qs": "6.17.1",
      "sharp": "0.35.5",
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2"
    }
  }
}
